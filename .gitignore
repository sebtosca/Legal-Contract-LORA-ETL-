# Secrets
.env

# Python
__pycache__/
*.pyc
.venv/
.pytest_cache/
.ruff_cache/

# Data & model artifacts (large, regenerable via the pipeline)
data/raw/
data/*.parquet
*.safetensors
checkpoints/
wandb/

# Downloader checkpoint state (regenerable, but machine-specific progress)
etl/.download_checkpoint*

# All markdown kept local/out of GitHub except README.md (explicit user
# preference — note this also covers REPORT.md, the Phase 9 experiment
# report, even though the PRD frames that as a portfolio artifact meant to
# be visible in the repo).
*.md
!README.md
