# SEC EDGAR requires an identifying User-Agent on every request (fair-access policy).
# Format: "Sample Company Name AdminContact@sample.com"
SEC_EDGAR_USER_AGENT=

# Used by evaluation.adjudicate (GPT-4o label-disagreement adjudication)
OPENAI_API_KEY=

# Used for experiment tracking (training runs, sweeps)
WANDB_API_KEY=

# Elasticsearch connection (defaults match the docker-compose service)
ES_HOST=http://localhost:9200
